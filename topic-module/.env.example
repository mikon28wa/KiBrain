
# Topic-module configuration — copy to .env and adjust. No secrets in code.
# Database connection (the module's OWN MySQL instance/schema, EU principle).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kibrain_topic_dev

# HTTP port of the module service.
PORT=3001

# Base URL of the Brain REST API (read access for later steps).
BRAIN_API_BASE_URL=http://localhost:3000
